{
  "manifest_version": 3,
  "name": "Jeux-Concours – assistant de participation",
  "short_name": "Jeux-Concours",
  "version": "0.3.0",
  "description": "Trouve les jeux-concours gratuits, les classe par famille et pré-remplit les formulaires. Vous validez toujours vous-même.",
  "icons": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "action": {
    "default_title": "Jeux-Concours",
    "default_popup": "ui/panel.html",
    "default_icon": { "16": "icons/icon16.png", "32": "icons/icon32.png" }
  },
  "side_panel": { "default_path": "ui/panel.html" },
  "sidebar_action": {
    "default_title": "Jeux-Concours",
    "default_panel": "ui/panel.html",
    "default_icon": "icons/icon32.png",
    "open_at_install": false
  },
  "options_ui": { "page": "ui/options.html", "open_in_tab": true },
  "background": {
    "service_worker": "background.js",
    "scripts": ["background.js"],
    "type": "module"
  },
  "permissions": ["storage", "unlimitedStorage", "alarms", "notifications", "scripting", "tabs", "sidePanel"],
  "host_permissions": ["<all_urls>"],
  "browser_specific_settings": {
    "gecko": {
      "id": "jeux-concours@local",
      "strict_min_version": "121.0",
      "data_collection_permissions": { "required": ["none"] }
    }
  }
}
